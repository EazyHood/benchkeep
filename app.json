{
  "expo": {
    "name": "Benchkeep",
    "slug": "benchkeep",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/benchkeep-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eazyhood.benchkeep"
    },
    "android": {
      "package": "com.eazyhood.benchkeep",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E7",
        "foregroundImage": "./assets/benchkeep-adaptive-foreground.png",
        "monochromeImage": "./assets/benchkeep-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/benchkeep-favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Benchkeep"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      ["expo-image-picker", {"photosPermission": "Choose a photo of your piece to save your next point.", "cameraPermission": "Photograph your piece to keep the spot where you will continue.", "microphonePermission": false}]
    ]
  }
}
